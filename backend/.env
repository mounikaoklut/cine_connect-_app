# CineConnect Backend Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=CineConnect

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:goldberg786@localhost:5432/CineConnect

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=dev-secret-super-key-change-in-production-cineconnect
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Media (MinIO for local dev, AWS S3 for cloud)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=cineconnect-media
S3_REGION=ap-south-1
CDN_BASE_URL=http://localhost:9000/cineconnect-media

